# Configuration is read from the process environment only. Copy the names you need into your
# shell or a local .env that stays out of version control.

# Portfolio risk engine (src/swing_backtest/config.py). RISK_PORTFOLIO_VALUE is required by
# RiskLimits.from_env(); an empty or unset limit keeps its default from RiskLimits.
RISK_PORTFOLIO_VALUE=
RISK_MAX_POSITIONS=
RISK_MAX_PREMIUM_AT_RISK_PCT=
RISK_MAX_DAILY_DRAWDOWN_PCT=
RISK_MAX_EXPIRY_CONCENTRATION_PCT=
RISK_MAX_SECTOR_POSITIONS=
RISK_MAX_DIRECTIONAL_TILT_PCT=
RISK_MAX_PER_POSITION_RISK_PCT=

# Optional broker market data for the review apps. Without them the apps run offline on the
# synthetic sample session.
ALPACA_API_KEY=
ALPACA_API_SECRET=
